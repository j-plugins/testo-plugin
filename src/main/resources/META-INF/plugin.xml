<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <id>com.github.xepozz.testo</id>
    <name>Testo PHP</name>
    <vendor email="xepozz@list.ru" url="https://github.com/xepozz">Dmitrii Derepko (@xepozz)</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends optional="true" config-file="coverage.xml">com.intellij.modules.coverage</depends>

    <!-- JCEF, for the report tab. Must stay an optional depends: the module form (intellij.platform.ui.jcef in
         <dependencies>) is mandatory and does not exist on 252, where JCEF is part of the monolith. -->
    <depends optional="true" config-file="jcef.xml">com.intellij.modules.jcef</depends>

    <resource-bundle>messages.TestoBundle</resource-bundle>

    <!-- The PHP plugin this build runs on: its dependency and every registration that needs its classes. -->
    <xi:include href="/META-INF/testo-php.xml"/>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
                name="PHP"
                fileNames="testo;testo.php;testo.bat"/>
        <runLineMarkerContributor
                language="PHP" order="first"
                implementationClass="com.github.xepozz.testo.tests.TestoTestRunLineMarkerProvider"/>
        <runAnything.executionProvider
                implementation="com.github.xepozz.testo.tests.runAnything.TestoRunAnythingProvider"/>

        <implicitUsageProvider
                implementation="com.github.xepozz.testo.references.TestFunctionImplicitUsageProvider"/>
        <iconProvider
                implementation="com.github.xepozz.testo.ui.TestoIconProvider"/>

        <fileEditorProvider
                implementation="com.github.xepozz.testo.ui.TestoReportFileEditorProvider"/>

        <codeInsight.daemonBoundCodeVisionProvider
                implementationClass="com.github.xepozz.testo.ui.TestoHistoryCodeVisionProvider"/>
        <codeInsight.daemonBoundCodeVisionProvider
                implementationClass="com.github.xepozz.testo.ui.TestoCoverageByTestCodeVisionProvider"/>
        <!-- Names/descriptions for the two lenses in Settings | Editor | Inlay Hints | Code Vision. -->
        <config.codeVisionGroupSettingProvider
                implementation="com.github.xepozz.testo.ui.TestoHistoryCodeVisionGroupSettingProvider"/>
        <config.codeVisionGroupSettingProvider
                implementation="com.github.xepozz.testo.ui.TestoCoverageByTestCodeVisionGroupSettingProvider"/>

        <!--        <notificationGroup-->
        <!--                id="Testo"-->
        <!--                displayType="TOOL_WINDOW"-->
        <!--                toolWindowId="Run"-->
        <!--                isLogByDefault="false"-->
        <!--                bundle="messages.TestoBundle"-->
        <!--                key="notification.group"/>-->
        <notificationGroup
                id="Testo"
                displayType="TOOL_WINDOW"
                toolWindowId="Run"
                isLogByDefault="false"
                bundle="messages.TestoBundle"
                key="notification.group"/>
        <!-- Unavailable until the first mutation run (TestoMutationToolWindow), like Coverage's. -->
        <toolWindow id="Mutations" anchor="right" secondary="false" canCloseContents="true" doNotActivateOnStart="true"
                    icon="/icons/testo/mutation.svg"
                    factoryClass="com.github.xepozz.testo.infection.TestoMutationToolWindowFactory"/>

        <!--                <pathMacroFilter implementation="com.jetbrains.php.phpunit.PhpUnitPathMacroFilter" />-->
        <!--        <iconProvider implementation="com.github.xepozz.testo.ui.TestoIconProvider"/>-->

        <!--        <intentionAction>-->
        <!--            <language>PHP</language>-->
        <!--            <className>com.github.xepozz.testo.actions.PhpNewTestIntention</className>-->
        <!--            <categoryKey>intention.group</categoryKey>-->
        <!--            <bundleName>messages.TestoBundle</bundleName>-->
        <!--        </intentionAction>-->

        <internalFileTemplate name="Testo Test"/>
        <defaultLiveTemplates file="/liveTemplates/Testo.xml"/>
        <liveTemplateContext
                contextId="Testo"
                baseContextId="PHP"
                implementation="com.github.xepozz.testo.TestoContext"/>
        <console.folding
                implementation="com.github.xepozz.testo.ui.TestoStackTraceConsoleFolding"/>
        <console.folding
                implementation="com.github.xepozz.testo.tests.console.TestoRepeatedFrameFolding"/>
        <fileBasedIndex
                implementation="com.github.xepozz.testo.index.TestoDataProvidersIndex"/>
        <fileBasedIndex
                implementation="com.github.xepozz.testo.index.TestoGroupsIndex"/>

        <spellchecker.bundledDictionaryProvider
                implementation="com.github.xepozz.testo.SpellcheckingDictionaryProvider"/>
        <lang.inspectionSuppressor
                language="PHP"
                implementationClass="com.github.xepozz.testo.tests.inspections.TestoInspectionSuppressor"/>
    </extensions>

    <projectListeners>
        <listener class="com.github.xepozz.testo.tests.console.TestoConsoleAugmenter"
                  topic="com.intellij.execution.ExecutionListener"/>
    </projectListeners>

    <actions>
        <!-- Variant A (TestoRerunStyle.MIRROR_AWARE): executor-pinned rerun trio, placed BEFORE the platform
             "Rerun" (FakeRerunAction, which mirrors the current executor). Each button hides itself when it would
             duplicate the platform "Rerun", so there are always 3 distinct rerun options. -->
        <group id="Testo.RerunExecutors">
            <action id="Testo.Rerun"
                    class="com.github.xepozz.testo.tests.actions.TestoRerunAction"/>
            <action id="Testo.RerunWithCoverage"
                    class="com.github.xepozz.testo.tests.actions.TestoRerunWithCoverageAction"/>
            <action id="Testo.RerunWithDebugger"
                    class="com.github.xepozz.testo.tests.actions.TestoRerunWithDebuggerAction"/>
            <add-to-group group-id="RunTab.TopToolbar" anchor="before" relative-to-action="Rerun"/>
        </group>

        <!-- Variant B (TestoRerunStyle.SPLIT_BUTTON): single split button replacing the trio + platform "Rerun". -->
        <action id="Testo.RerunSplit"
                class="com.github.xepozz.testo.tests.actions.TestoRerunSplitButtonAction">
            <add-to-group group-id="RunTab.TopToolbar" anchor="before" relative-to-action="Rerun"/>
        </action>

        <!-- The Mutations tool window (TestoMutationPanel): its toolbar and its tree's context menu. -->
        <group id="Testo.Mutations.Toolbar">
            <action id="Testo.Mutations.Rerun" class="com.github.xepozz.testo.infection.TestoMutationRerunAction"/>
            <action id="Testo.Mutations.RerunEscaped" class="com.github.xepozz.testo.infection.TestoMutationRerunEscapedAction"/>
            <action id="Testo.Mutations.Stop" class="com.github.xepozz.testo.infection.TestoMutationStopAction"/>
            <separator/>
            <action id="Testo.Mutations.EscapedOnly" class="com.github.xepozz.testo.infection.TestoMutationEscapedOnlyAction"/>
            <group id="Testo.Mutations.GroupBy" class="com.github.xepozz.testo.infection.TestoMutationGroupByGroup"/>
            <group id="Testo.Mutations.MutatorFilter" class="com.github.xepozz.testo.infection.TestoMutationMutatorFilterGroup"/>
            <action id="Testo.Mutations.EditorMarks" class="com.github.xepozz.testo.infection.TestoMutationEditorMarksAction"/>
            <action id="Testo.Mutations.OpenReport" class="com.github.xepozz.testo.infection.TestoMutationOpenReportAction"/>
            <separator/>
            <action id="Testo.Mutations.Pin" class="com.github.xepozz.testo.infection.TestoMutationPinAction"/>
        </group>
        <group id="Testo.Mutations.Popup">
            <reference ref="EditSource"/>
            <action id="Testo.Mutations.RerunSelected" class="com.github.xepozz.testo.infection.TestoMutationRerunSelectedAction"/>
            <group id="Testo.Mutations.Tests" class="com.github.xepozz.testo.infection.TestoMutationTestsGroup"/>
            <action id="Testo.Mutations.Apply" class="com.github.xepozz.testo.infection.TestoMutationApplyAction"/>
            <action id="Testo.Mutations.Ignore" class="com.github.xepozz.testo.infection.TestoMutationIgnoreAction"/>
            <separator/>
            <action id="Testo.Mutations.CopyId" class="com.github.xepozz.testo.infection.TestoMutationCopyIdAction"/>
        </group>

        <!-- Override the platform "Rerun" so it can step aside for the split button in variant B. -->
        <action id="Rerun" overrides="true"
                class="com.github.xepozz.testo.tests.actions.TestoAwareRerunAction"/>

        <!-- Log-level filter lives on the console's own toolbar (TestoConsoleProperties.appendAdditionalActions),
             not the run/debug tab toolbar, so it appears for both run and debug consoles. -->

        <group id="Testo.ToolsMenu" text="Testo" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Testo.ShowChannelIcons"
                    class="com.github.xepozz.testo.tests.console.TestoShowChannelIconsAction"
                    text="Channel Icons"
                    description="Preview the mapping of Testo channel icon hints to IDE icons"/>
            <separator/>
            <action id="Testo.RerunStyle.Mirror"
                    class="com.github.xepozz.testo.tests.actions.TestoRerunStyleMirrorAction"/>
            <action id="Testo.RerunStyle.Split"
                    class="com.github.xepozz.testo.tests.actions.TestoRerunStyleSplitAction"/>
            <separator/>
            <action id="Testo.RunHistory"
                    class="com.github.xepozz.testo.runs.TestoRunHistoryAction"/>
        </group>
        <action id="Testo.AddSkippedPath"
                class="com.github.xepozz.testo.tests.actions.TestoAddSkippedPathAction"
                text="Add File to Skipped Paths"
                description="Open PHP Debug Skipped Paths settings to exclude this file from stepping">
            <add-to-group group-id="XDebugger.Frames.TopToolbar" anchor="last"/>
            <add-to-group group-id="XDebugger.Frames.Tree.Popup" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
