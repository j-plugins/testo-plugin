<idea-plugin xmlns:xi="http://www.w3.org/2001/XInclude">
    <!-- Coverage registrations that need the PHP plugin's classes; loaded under the same coverage condition. -->
    <xi:include href="/META-INF/testo-php-coverage.xml"/>

    <extensions defaultExtensionNs="com.intellij">
        <coverageEngine implementation="com.github.xepozz.testo.coverage.TestoCoverageEngine"/>
        <coverageRunner implementation="com.github.xepozz.testo.coverage.TestoCoverageRunner"/>
        <!-- Run with Mutation shares the UI; the PHP-specific descriptor supplies its runner. -->
        <executor implementation="com.github.xepozz.testo.infection.TestoMutationExecutor"/>
        <projectService serviceImplementation="com.github.xepozz.testo.coverage.TestoCoverageAnnotator"/>
        <!-- "Run covering tests (N)" on methods, functions and classes; silent until a coverage-xml report is loaded. -->
        <codeInsight.lineMarkerProvider language="PHP"
                                        implementationClass="com.github.xepozz.testo.coverage.editor.TestoCoveringTestsLineMarkerProvider"/>
    </extensions>
    <actions>
        <action id="Testo.MutateFile" class="com.github.xepozz.testo.coverage.TestoMutateFileAction">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="RunContextGroup"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="RunContextGroup"/>
        </action>
    </actions>
</idea-plugin>
